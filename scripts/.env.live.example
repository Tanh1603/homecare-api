# Operator environment only; do not paste real values into this template.
# COMPOSE_ENV_FILE=PLACEHOLDER
# DEV_PKI_DIRECTORY=PLACEHOLDER
# DEV_PKI_PASSWORD=PLACEHOLDER
FIREBASE_LIVE_TEST=false
FIREBASE_PROJECT_ID=PLACEHOLDER
GOOGLE_APPLICATION_CREDENTIALS=PLACEHOLDER
FIREBASE_WEB_API_KEY=PLACEHOLDER
FIREBASE_TEST_UID=PLACEHOLDER
FIREBASE_TEST_EMAIL=PLACEHOLDER
FIREBASE_TEST_PASSWORD=PLACEHOLDER
# Optional separate credential for revoke/disable; never passed to application containers.
FIREBASE_OPERATOR_CREDENTIALS=PLACEHOLDER
FIREBASE_TEST_MUTATIONS=true
GATEWAY_URL=https://localhost:8080
IDENTITY_URL=https://localhost:8443
GATEWAY_TLS_KEYSTORE=PLACEHOLDER
GATEWAY_TLS_KEYSTORE_PASSWORD=PLACEHOLDER
IDENTITY_TLS_KEYSTORE=PLACEHOLDER
IDENTITY_TLS_KEYSTORE_PASSWORD=PLACEHOLDER
ROGUE_TLS_KEYSTORE=PLACEHOLDER
ROGUE_TLS_KEYSTORE_PASSWORD=PLACEHOLDER
TLS_TRUSTSTORE=PLACEHOLDER
TLS_TRUSTSTORE_PASSWORD=PLACEHOLDER
LIVE_DB_URL=jdbc:postgresql://localhost:55432/hc_test_live_identity
LIVE_DB_USERNAME=hc_test_live_identity_app
LIVE_DB_PASSWORD=PLACEHOLDER
# Optional cases: supply an actual expired Google token, never a fabricated fixture.
# FIREBASE_EXPIRED_ID_TOKEN=PLACEHOLDER
# FIREBASE_WRONG_PROJECT_ID_TOKEN=PLACEHOLDER
# Set true only when running isolated Docker fault injection.
FIREBASE_NETWORK_FAULT_TEST=false
LIVE_COMPOSE_PROJECT=homecare-foundation
# Mapping task only; supply migrator credentials outside this file.
# MAP_DB_URL=jdbc:postgresql://localhost:55432/hc_test_live_identity
# MAP_DB_USERNAME=hc_test_live_identity_migrator
# MAP_DB_PASSWORD=PLACEHOLDER
# MAP_FIREBASE_UID=PLACEHOLDER
# MAP_ROLE=HOUSEHOLD_USER
