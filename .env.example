# HomeCare Backend Infrastructure & Service Environment Example
# Copy to .env and adjust values for local development (never commit real secrets).

# PostgreSQL (Shared Infrastructure + 6 Service Databases)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_pg_password
POSTGRES_DB=postgres
POSTGRES_MULTIPLE_DATABASES=household_db,provider_db,booking_db,commerce_db,review_db,notification_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=homecare
RABBITMQ_DEFAULT_PASS=change_me_local_mq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Supabase Cloud Identity & Auth (IdP)
# NOTE: Supabase Cloud project must have Asymmetric Keys (RS256) enabled in Dashboard
# (Settings -> API -> JWT Settings) when using SUPABASE_JWKS_URI with Spring Resource Server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Internal Workload Authentication (gRPC & Internal Communication)
INTERNAL_WORKLOAD_TOKEN=change_me_internal_workload_token
HOUSEHOLD_GRPC_PORT=9082
HOUSEHOLD_GRPC_ADDRESS=static://household-service:9082
PROVIDER_GRPC_PORT=9083
PROVIDER_GRPC_ADDRESS=static://provider-service:9083
BOOKING_GRPC_PORT=9084
BOOKING_GRPC_ADDRESS=static://booking-service:9084
COMMERCE_GRPC_PORT=9085
COMMERCE_GRPC_ADDRESS=static://commerce-service:9085

# Firebase Cloud Messaging (FCM)
# Pass raw service account JSON string or path to JSON file
# FCM_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_PATH=

# VNPAY Sandbox Payment Configuration (commerce-service)
VNPAY_TMN_CODE=HOMECARE01
VNPAY_HASH_SECRET=HOMECARE_VNPAY_SANDBOX_SECRET_KEY_2026
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/orders/payment-result

# Gateway & Downstream Origin Protection (Defense in Depth)
HOMECARE_SECURITY_ENFORCE_GATEWAY=true
INTERNAL_GATEWAY_SECRET=homecare-internal-secret-2026



# JVM Memory & GC Optimization (Limits memory footprint and prevents PC freezing)
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m
