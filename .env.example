# HomeCare Backend Infrastructure & Service Environment Example
# Copy to .env and adjust values for local development (never commit real secrets).

# PostgreSQL (Shared Infrastructure + 7 Service Databases)
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me_local_pg_password
POSTGRES_DB=keycloak
POSTGRES_MULTIPLE_DATABASES=identity_db,household_db,provider_db,booking_db,commerce_db,review_db,notification_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=homecare
RABBITMQ_DEFAULT_PASS=change_me_local_mq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Keycloak
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change_me_local_pg_password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local_kc_admin_password
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=homecare
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/homecare
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/homecare/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=homecare-auth
KEYCLOAK_CLIENT_SECRET=change_me_local_client_secret

# Internal Workload Authentication (gRPC & Internal REST)
INTERNAL_WORKLOAD_TOKEN=change_me_internal_workload_token
PROVIDER_GRPC_PORT=9083
