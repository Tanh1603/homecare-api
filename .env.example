# Copy is illustrative only; scripts/dev.ps1 init generates distinct local credentials.
# Do not commit .env; never use these placeholders as passwords.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=REPLACE_LOCALLY
RABBITMQ_PORT=55672
RABBITMQ_URL=amqp://127.0.0.1:55672
RABBITMQ_USERNAME=homecare_dev
RABBITMQ_PASSWORD=REPLACE_LOCALLY
RABBITMQ_VHOST=homecare
IDENTITY_DB_PASSWORD=REPLACE_LOCALLY
IDENTITY_MIGRATOR_PASSWORD=REPLACE_LOCALLY
HOUSEHOLD_DB_PASSWORD=REPLACE_LOCALLY
HOUSEHOLD_MIGRATOR_PASSWORD=REPLACE_LOCALLY
PROVIDER_DB_PASSWORD=REPLACE_LOCALLY
PROVIDER_MIGRATOR_PASSWORD=REPLACE_LOCALLY
BOOKING_DB_PASSWORD=REPLACE_LOCALLY
BOOKING_MIGRATOR_PASSWORD=REPLACE_LOCALLY
COMMERCE_DB_PASSWORD=REPLACE_LOCALLY
COMMERCE_MIGRATOR_PASSWORD=REPLACE_LOCALLY
REVIEW_DB_PASSWORD=REPLACE_LOCALLY
REVIEW_MIGRATOR_PASSWORD=REPLACE_LOCALLY
NOTIFICATION_DB_PASSWORD=REPLACE_LOCALLY
NOTIFICATION_MIGRATOR_PASSWORD=REPLACE_LOCALLY
# Direct host-installed services are supported with the same version/roles/grants.
# Application variables selected by scripts/dev.ps1 run -Service identity:
# DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/hc_dev_identity
# DB_USERNAME=hc_dev_identity_app
# DB_PASSWORD=<IDENTITY_DB_PASSWORD>
# Migration job uses LIQUIBASE_COMMAND_URL/USERNAME/PASSWORD, never the app account.
# Phase3 real dev run: supply your environment values and Application Default Credentials.
# Do not set FIREBASE_AUTH_EMULATOR_HOST: production verifier rejects unsigned emulator mode.
# FIREBASE_PROJECT_ID=<dev-project>
# GOOGLE_APPLICATION_CREDENTIALS=<absolute-local-credential-path>
# IDENTITY_TLS_KEYSTORE=file:<absolute-path-to-identity.p12>
# IDENTITY_TLS_KEYSTORE_PASSWORD=<local-secret>
# GATEWAY_TLS_KEYSTORE=file:<absolute-path-to-gateway.p12>
# GATEWAY_TLS_KEYSTORE_PASSWORD=<local-secret>
# TLS_TRUSTSTORE=file:<absolute-path-to-dedicated-workload-ca-truststore.p12>
# TLS_TRUSTSTORE_PASSWORD=<local-secret>
# IDENTITY_URL=https://localhost:8443
# PROVIDER_URL=https://localhost:8444
# COMMERCE_URL=https://localhost:8445
# CORS_ORIGINS=https://your-local-web-origin
