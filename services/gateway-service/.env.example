# HomeCare Gateway Service (:8080) — Environment Example
SERVER_PORT=8080
REDIS_HOST=redis
REDIS_PORT=6379
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Downstream Microservice Base URLs (Docker Network)
HOUSEHOLD_URL=http://household-service:8082
PROVIDER_URL=http://provider-service:8083
BOOKING_URL=http://booking-service:8084
COMMERCE_URL=http://commerce-service:8085
REVIEW_URL=http://review-service:8086
NOTIFICATION_URL=http://notification-service:8087

# JVM Resource Optimization
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m

# Internal Gateway Secret for downstream origin validation
INTERNAL_GATEWAY_SECRET=homecare-internal-secret-2026
