# HomeCare Commerce Service (:8085 HTTP / :9085 gRPC) — Environment Example
SERVER_PORT=8085
COMMERCE_GRPC_PORT=9085

DB_URL=jdbc:postgresql://postgres:5432/commerce_db
DB_USER=postgres
DB_PASSWORD=change_me_local_pg_password

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=homecare
RABBITMQ_DEFAULT_PASS=change_me_local_mq_password

SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
INTERNAL_WORKLOAD_TOKEN=change_me_internal_workload_token

# VNPAY Sandbox Payment Configuration
VNPAY_TMN_CODE=HOMECARE01
VNPAY_HASH_SECRET=HOMECARE_VNPAY_SANDBOX_SECRET_KEY_2026
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/orders/payment-result

# JVM Resource Optimization
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m
