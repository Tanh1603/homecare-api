# HomeCare Booking Service (:8084 HTTP / :9084 gRPC) — Environment Example
SERVER_PORT=8084
BOOKING_GRPC_PORT=9084

DB_URL=jdbc:postgresql://postgres:5432/booking_db
DB_USER=keycloak
DB_PASSWORD=change_me_local_pg_password

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=homecare
RABBITMQ_DEFAULT_PASS=change_me_local_mq_password

KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/homecare
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/homecare/protocol/openid-connect/certs
INTERNAL_WORKLOAD_TOKEN=change_me_internal_workload_token

# Internal Inter-Service gRPC Channels
PROVIDER_GRPC_ADDRESS=static://provider-service:9083
HOUSEHOLD_GRPC_ADDRESS=static://household-service:9082
HOUSEHOLD_INTERNAL_URL=http://household-service:8082

# JVM Resource Optimization
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m
