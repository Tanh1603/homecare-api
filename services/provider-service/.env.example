# HomeCare Provider Service (:8083 HTTP / :9083 gRPC) — Environment Example
SERVER_PORT=8083
PROVIDER_GRPC_PORT=9083

DB_URL=jdbc:postgresql://postgres:5432/provider_db
DB_USER=postgres
DB_PASSWORD=change_me_local_pg_password

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=homecare
RABBITMQ_DEFAULT_PASS=change_me_local_mq_password

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=your-supabase-secret-key
ORGANIZATION_OUTBOX_POLL_MS=5000
INTERNAL_WORKLOAD_TOKEN=change_me_internal_workload_token

# JVM Resource Optimization
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m
