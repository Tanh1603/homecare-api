# HomeCare Identity Service (:8081) — Local Environment Example
# Copy to .env when running identity-service standalone outside Docker Compose.

SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/identity_db
DB_USER=keycloak
DB_PASSWORD=change_me_local_pg_password

REDIS_HOST=localhost
REDIS_PORT=6379

KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=homecare
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/homecare
KEYCLOAK_CLIENT_ID=homecare-auth
KEYCLOAK_CLIENT_SECRET=change_me_local_client_secret
KEYCLOAK_TOKEN_SCOPE=openid profile email roles
KEYCLOAK_DEFAULT_ROLE=CUSTOMER
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local_kc_admin_password

INTERNAL_WORKLOAD_TOKEN=change_me_internal_workload_token

# JVM Resource Optimization
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx384m -XX:MaxMetaspaceSize=128m
